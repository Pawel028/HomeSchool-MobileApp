# Flutter / Dart
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
pubspec.lock.bak

# Android (generated by `flutter create`, re-created by tools/bootstrap.ps1)
# The android/ folder IS committed once bootstrapped, except for secrets and local files:
android/key.properties
android/local.properties
android/.gradle/
android/app/debug/
android/app/profile/
android/app/release/
android/captures/
*.jks
*.keystore
*.p12
*.pfx

# IDEs
.idea/
*.iml
.vscode/
.DS_Store

# NOTE: env/*.json is deliberately committed (no secrets in them: they ship inside the app).
