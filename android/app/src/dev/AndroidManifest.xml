<?xml version="1.0" encoding="utf-8"?>
<!--
  Dev-flavor manifest overlay, merged by the Android Gradle Plugin into src/main/AndroidManifest.xml only
  for the `dev` flavor (this file lives under src/dev/, a flavor-specific source set). It just points the
  merged manifest at the cleartext network security config next to this file.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
